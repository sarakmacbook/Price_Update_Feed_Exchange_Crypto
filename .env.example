# Copy to .env and fill, or use install.sh wizard
# Used by Docker and (optionally) by bot.py — env overrides config.json

BOT_TOKEN=123456:ABC-your-token-from-BotFather
ADMIN_IDS=123456789
# comma-separated for multiple admins: 123456789,987654321

ASSET=USDT
FIAT=USD
INTERVAL=60

# ─────────────────────────────────────────────────────────────────────────────
# Vercel / serverless deployment — see the "Deploy on Vercel" section in README
# ─────────────────────────────────────────────────────────────────────────────

# Secret for the scheduled endpoints: /api/cron and /api/setup
# (cron-job.org, UptimeRobot, GitHub Actions or Vercel Cron send it as
#  `Authorization: Bearer <value>`; you can also use ?key=<value>)
# CRON_SECRET=change-me-to-a-random-string

# Optional: extra check for Telegram webhook calls (sent as
# X-Telegram-Bot-Api-Secret-Token). Recommended on Vercel.
# WEBHOOK_SECRET=another-random-string

# Public base URL of the deployment (only needed if Vercel's own domain is not
# what you want /api/setup to register).
# PUBLIC_URL=https://your-project.vercel.app

# State store — REQUIRED for a Vercel deployment if you want state (merchants,
# group, settings) to survive cold starts. Vercel KV / Upstash Redis REST:
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxxxx
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)
# P2P_STATE_KEY=p2p-price-bot:state

# Where to keep data.json when the file backend is used (systemd/Docker/local)
# P2P_DATA_DIR=/var/lib/p2p-bot

# Deep-link templates for the exact-ad buttons (JSON). Defaults live in
# adlinks.py; override any exchange here or from the bot UI (Settings ▸ 🔗 Ad links).
# AD_LINK_TEMPLATES={"okx": "https://www.okx.com/p2p-markets/{FIAT_LOWER}/{TAKER_SIDE}-{ASSET_LOWER}?adId={AD_ID}"}
